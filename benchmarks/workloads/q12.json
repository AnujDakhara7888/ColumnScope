          "left": { "type": "column", "name": "selectivity_key" },
          "right": { "type": "literal", "literal": { "type": "int64", "value": 1000 } }
        },
        "right": {
          "type": "eq",
          "left": { "type": "column", "name": "active" },
          "right": { "type": "literal", "literal": { "type": "boolean", "value": true } }
        }
      }
    },
    "group_by": [
