      { "name": "region", "data_type": "utf8", "nullable": false },
      { "name": "category", "data_type": "utf8", "nullable": false },
      { "name": "amount_cents", "data_type": "int64", "nullable": true },
      { "name": "metric", "data_type": "float64", "nullable": true },
      { "name": "active", "data_type": "boolean", "nullable": true },
      { "name": "selectivity_key", "data_type": "int64", "nullable": false }
    ]
  },
  "plan": {
    "type": "aggregate",
    "input": {
      "type": "filter",
      "input": { "type": "scan" },
      "predicate": {
